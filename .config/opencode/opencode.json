{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugins": ["file:///Users/dario/.local/share/opencode-plugins/opencode-claude-auth-v2"],
  "mcp": {
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/v1/mcp",
      "enabled": true,
      "oauth": {}
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "tools": {
    "atlassian_*": false,
    "atlassian_get*": true,
    "atlassian_search*": true,
    "atlassian_fetch": true,
    "atlassian_lookupJiraAccountId": true,
    "atlassian_atlassianUserInfo": true
  }
}
